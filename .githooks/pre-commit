#!/usr/bin/env bash
# Keeps sdk/python/README.md in sync with the root README.md.
#
# `make generate_python` copies the root README into the python SDK, so editing
# README.md alone leaves that copy stale and CI's codegen job fails on the diff
# (`git diff --exit-code -- sdk ...`). This has bitten the repo more than once,
# so sync it at commit time instead of after a red check.
#
# The copy is taken from the *index*, not the worktree, so a partially staged
# README still produces an SDK copy that matches what is being committed.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
dst="$root/sdk/python/README.md"

staged="$(mktemp)"
trap 'rm -f "$staged"' EXIT

git show :README.md >"$staged"

if cmp -s "$staged" "$dst"; then
  exit 0
fi

cp "$staged" "$dst"
git add -- "$dst"
echo "pre-commit: synced sdk/python/README.md from README.md"
