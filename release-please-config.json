{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "pulumi-provider-git",
      "include-component-in-tag": false,
      "version-file": "VERSION",
      "extra-files": [
        { "type": "json", "path": "sdk/nodejs/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "sdk/nodejs/package.json", "jsonpath": "$.pulumi.version" },
        { "type": "json", "path": "sdk/nodejs/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "sdk/nodejs/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "sdk/go/git/pulumi-plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "sdk/python/pulumi_git/pulumi-plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "sdk/dotnet/pulumi-plugin.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "sdk/python/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "xml", "path": "sdk/dotnet/UnMango.Git.csproj", "xpath": "//Project/PropertyGroup/Version" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation" },
        { "type": "refactor", "section": "Code Refactoring" },
        { "type": "test", "section": "Tests" },
        { "type": "build", "section": "Build System" },
        { "type": "ci", "section": "Continuous Integration" },
        { "type": "chore", "section": "Miscellaneous Chores", "hidden": true }
      ]
    }
  }
}
